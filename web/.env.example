# My Agent web — environment variables
# Copy to web/.env.local

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (omit both lines below → cookie dev login under data/users/dev/)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_publishable_key

# If Supabase project URL is wrong/unreachable but vars are still set:
# FORCE_DEV_AUTH=true

# POC login (no magic link — avoids email rate limits)
AUTH_POC_PASSWORD=MyAgentPOC2026

# Secret key from Supabase → Settings → API Keys (server only)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Ask Agent — Gemini (optional — synthesis only; framework rules always bind)
# GOOGLE_GENERATIVE_AI_API_KEY=your_gemini_api_key
# GEMINI_MODEL=gemini-3.6-flash
# See web/lib/agent/ASK-AGENT-RULES.md for framework-first precedence

# CMP — live NSE (Dashboard / Portfolio); cache TTL ms (default 300000 = 5 min)
# CMP_CACHE_TTL_MS=300000

# Weekly sector cap-tier mcap refresh (cron / Task Scheduler)
# CRON_SECRET=your_random_secret_for_api_cron
# Schedule: GET/POST /api/cron/refresh-sector-mcap with Authorization: Bearer $CRON_SECRET
# Local: npm run refresh-sector-mcap  (every Sunday recommended)

# Daily morning market pack @ 8 AM IST (Task Scheduler or HTTP cron)
# CRON_TENANT_ID=your_supabase_user_uuid   # portfolio in data/users/{id}/portfolio/
# CRON_USER_EMAIL=you@example.com          # optional — news agent inbox label
# Register Windows task:  cd web && .\scripts\register-morning-cron.ps1
# Manual test:           npm run daily-market-pack
# HTTP (server running): curl -X POST http://localhost:3000/api/cron/daily-market-pack -H "Authorization: Bearer $CRON_SECRET"
